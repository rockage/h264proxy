# Copy to build/client.env, replace the example values with the current VPS.
# Environment variables override this file. Values are literal, not shell code.
H264_ENDPOINT=YOUR_CURRENT_VPS:9300
H264_SSH=root@YOUR_CURRENT_VPS
H264_TUN_SERVICE=Wi-Fi
# Optional for start_tun.sh; start_proxy.sh selects explicitly by switch.
# H264_TUN_BACKEND=sing-box
# Independent transport trials; defaults remain the stable checkpoint values.
# H264_DC_HIGH_WATER=1048576
# H264_DC_LOW_WATER=524288
# H264_STREAM_RECEIVE_WINDOW=1048576
# Set the key file that matches this VPS; quote absolute paths containing spaces.
# H264_KEY="/absolute/path/to/current-vps.key"
# H264_RESTART_GATEWAY=0
# H264_STUN=""

# Set tcp only when the paired gateway enables ICE TCP; default is udp.
# H264_ICE_TRANSPORT=tcp
